{
  "name": "pixel-pipe",
  "version": "1.0.0",
  "description": "Pixel-Pipe: An AI-Powered Media Analysis Platform built on a serverless, event-driven architecture with AWS and Terraform.",
  "main": "index.js",
  "scripts": {
    "build:get-upload-url": "node scripts/build-lambda.cjs get-upload-url",
    "build:dispatch-tasks": "node scripts/build-lambda.cjs dispatch-tasks",
    "build:resize-worker": "node scripts/build-lambda.cjs resize-worker",
    "build:analysis-worker": "node scripts/build-lambda.cjs analysis-worker",
    "build": "npm run build:get-upload-url && npm run build:dispatch-tasks && npm run build:resize-worker && npm run build:analysis-worker"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HumbleChaudhry/pixel-pipe.git"
  },
