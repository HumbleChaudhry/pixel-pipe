  },
  "homepage": "https://github.com/HumbleChaudhry/pixel-pipe#readme",
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.893.0",
    "@aws-sdk/client-dynamodb": "^3.859.0",
    "@aws-sdk/client-rekognition": "^3.859.0",
    "@aws-sdk/client-s3": "^3.844.0",
    "@aws-sdk/client-sns": "^3.844.0",
    "@aws-sdk/lib-dynamodb": "^3.859.0",
    "@aws-sdk/s3-request-presigner": "^3.844.0",
    "aws-xray-sdk": "^3.10.3",
    "pino": "^9.9.5",
